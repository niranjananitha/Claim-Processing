# Copy to .env and fill in real values. NEVER commit .env.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=claims_database

# JWT / security
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# CORS (frontend origin)
CORS_ORIGINS=http://localhost:3000

# Permanent manager password (used by `python -m app.seed`). Change it!
SEED_MANAGER_PASSWORD=change-me-strong-password

# Permanent manager account (ensured by `python -m app.seed`; password = SEED_MANAGER_PASSWORD)
MANAGER_EMAIL=manager@aegis.com
MANAGER_NAME=Catherine Ross
MANAGER_TITLE=Regional Claims Operations Director
